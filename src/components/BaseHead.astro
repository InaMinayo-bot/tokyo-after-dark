---
import '@fontsource/syne/latin-700.css';
import '@fontsource/syne/latin-800.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import { site } from '../data/site';
import { absoluteUrl, url } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  tags?: string[];
  searchAssets?: boolean;
}

const {
  title,
  description,
  image = absoluteUrl('/og.png'),
  imageAlt = site.defaultImageAlt,
  type = 'website',
  noindex = false,
  published,
  modified,
  tags = [],
  searchAssets = false,
} = Astro.props;

const fullTitle = title === site.name ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://inaminayo-bot.github.io');
const pagefindBase = import.meta.env.BASE_URL;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#09080d" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/icon-180.png')} />
<link rel="manifest" href={url('/manifest.webmanifest')} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={url('/rss.xml')} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
{
  searchAssets && (
    <>
      <link rel="stylesheet" href={`${pagefindBase}pagefind/pagefind-component-ui.css`} />
      <script type="module" src={`${pagefindBase}pagefind/pagefind-component-ui.js`}></script>
    </>
  )
}
