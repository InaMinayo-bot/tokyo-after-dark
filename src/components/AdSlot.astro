---
/**
 * Renders nothing until ads are switched on.
 * Set PUBLIC_ADS_ENABLED=true, then paste the ad snippet inside the aside.
 */
interface Props {
  placement: 'home' | 'post';
}

const { placement } = Astro.props;
const enabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
---

{
  enabled && (
    <aside class="ad-slot" data-ad-placement={placement} aria-label="Advertisement" data-pagefind-ignore="all">
      <p class="ad-label">Advertisement</p>
    </aside>
  )
}
