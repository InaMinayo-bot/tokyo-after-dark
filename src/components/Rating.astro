---
interface Props {
  rating: number;
}

const { rating } = Astro.props;
---

<span class="rating">
  <span class="stars" aria-hidden="true">
    {
      Array.from({ length: 5 }, (_, index) => (
        <svg viewBox="0 0 20 20" width="16" height="16" class={index < rating ? 'on' : 'off'}>
          <path
            fill="currentColor"
            d="M10 1.6 12.5 7l6 .6-4.5 3.9 1.4 5.9L10 14.8 4.6 17.4 6 11.5 1.5 7.6 7.5 7z"
          />
        </svg>
      ))
    }
  </span>
  <span class="rating-text"><span class="visually-hidden">Rating </span>{rating}/5</span>
</span>
