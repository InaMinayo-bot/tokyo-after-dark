---
import { url } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'The newsletter form is not connected. Nothing you typed was stored.';
---

<BaseLayout title="Newsletter" description={description} noindex searchable={false}>
  <section class="wrap empty">
    <h1 class="page-title">Not connected yet</h1>
    <p>
      The signup form is a placeholder. This site did not store an email address, and it is not on a
      mailing list.
    </p>
    <p class="button-row">
      <a class="button" href={url('/')}>Back home</a>
      <a class="button ghost" href={url('/contact/')}>Contact</a>
    </p>
  </section>
</BaseLayout>
